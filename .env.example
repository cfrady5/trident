# ---------------------------------------------------------------------------
# Trident environment. Copy to .env.local for development.
# Development defaults run fully locally; nothing is sent anywhere.
# ---------------------------------------------------------------------------
APP_ENV=development              # development | test | demo | production
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@127.0.0.1:54329/trident
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Auth: local (dev magic links in the outbox) | supabase
AUTH_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server only. Never expose to the browser.

# Storage: local (.data/storage) | supabase
STORAGE_PROVIDER=local
STORAGE_BUCKET=trident-private
MAX_UPLOAD_MB=25
MALWARE_SCAN_URL=                # optional external scanner endpoint (see SECURITY.md)

# Email: dev_outbox (captured at /dev/outbox) | resend
EMAIL_PROVIDER=dev_outbox
RESEND_API_KEY=
EMAIL_FROM="Trident <no-reply@example.com>"
STAFF_NOTIFICATION_EMAILS=       # comma-separated

# AI: none | anthropic. With none, AI steps are recorded as blocked, never simulated.
# Additional providers plug into src/lib/ai/providers.ts (see ARCHITECTURE.md).
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MONTHLY_BUDGET_USD=50

# Payments (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Background jobs: Vercel Cron calls /api/jobs/run with this bearer token.
CRON_SECRET=
# Emails granted platform_owner on first sign-in (comma-separated).
PLATFORM_OWNER_EMAILS=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
